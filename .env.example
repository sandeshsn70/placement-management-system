# Copy this to .env on the VM (next to docker-compose.yml) and fill in real
# values. .env is git-ignored — it should never be committed.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=placement_management
MYSQL_USER=pms_app
MYSQL_PASSWORD=change-me

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me

# Filled in after your first GitHub Actions run creates the packages —
# see DEPLOYMENT_GCP.md. Replace YOUR_GITHUB_USERNAME.
BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/placement-management-system-backend:latest
FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/placement-management-system-frontend:latest
